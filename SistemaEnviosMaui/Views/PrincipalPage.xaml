<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemaEnviosMaui.Views.PrincipalPage"
             Title="PrincipalPage"
             BackgroundColor="#0A0E17"
             NavigationPage.HasNavigationBar="False">

    <Grid ColumnDefinitions="Auto, *">

        <Border x:Name="SidebarBorder" 
                Grid.Column="0" 
                WidthRequest="75"
                StrokeThickness="0" 
                BackgroundColor="#131722"
                HorizontalOptions="Start">

            <Border.GestureRecognizers>
                <PointerGestureRecognizer PointerEntered="OnSidebarPointerEntered" 
                                          PointerExited="OnSidebarPointerExited"/>
            </Border.GestureRecognizers>

            <Grid RowDefinitions="Auto, *, Auto" Padding="10, 20, 10, 20">

                <Grid Grid.Row="0" ColumnDefinitions="55, *" Margin="0,0,0,20">
                    <Border Grid.Column="0" StrokeShape="Ellipse" BackgroundColor="#4F46E5" WidthRequest="45" HeightRequest="45" StrokeThickness="0" HorizontalOptions="Center">
                        <Label Text="🚀" HorizontalOptions="Center" VerticalOptions="Center" FontSize="22"/>
                    </Border>
                    <Label x:Name="lblLogoTexto" Grid.Column="1" Text="LOGÍSTICA" TextColor="White" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" Margin="5,0,0,0" IsVisible="False"/>
                </Grid>

                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Fill">

                        <Border x:Name="MenuInicio" StrokeShape="RoundRectangle 12" BackgroundColor="#6366F1" HeightRequest="45" StrokeThickness="0" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="55, *">
                                <Label Grid.Column="0" Text="🏠" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Label x:Name="txtInicio" Grid.Column="1" Text="Inicio" TextColor="White" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" IsVisible="False"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Inicio" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border x:Name="MenuUsuarios" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" HeightRequest="45" StrokeThickness="0" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="55, *">
                                <Label Grid.Column="0" Text="👥" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Label x:Name="txtUsuarios" Grid.Column="1" Text="Usuarios" TextColor="#64748B" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" IsVisible="False"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Usuarios" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border x:Name="MenuClientes" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" HeightRequest="45" StrokeThickness="0" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="55, *">
                                <Label Grid.Column="0" Text="🤝" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Label x:Name="txtClientes" Grid.Column="1" Text="Clientes" TextColor="#64748B" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" IsVisible="False"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Clientes" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border x:Name="MenuInventario" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" HeightRequest="45" StrokeThickness="0" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="55, *">
                                <Label Grid.Column="0" Text="📦" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Label x:Name="txtInventario" Grid.Column="1" Text="Inventario" TextColor="#64748B" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" IsVisible="False"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Inventario" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border x:Name="MenuPedidos" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" HeightRequest="45" StrokeThickness="0" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="55, *">
                                <Label Grid.Column="0" Text="📋" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Label x:Name="txtPedidos" Grid.Column="1" Text="Pedidos" TextColor="#64748B" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" IsVisible="False"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Pedidos" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border x:Name="MenuRepartidores" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" HeightRequest="45" StrokeThickness="0" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="55, *">
                                <Label Grid.Column="0" Text="🚚" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Label x:Name="txtRepartidores" Grid.Column="1" Text="Repartidores" TextColor="#64748B" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" IsVisible="False"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Repartidores" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border x:Name="MenuFacturas" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" HeightRequest="45" StrokeThickness="0" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="55, *">
                                <Label Grid.Column="0" Text="🧾" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Label x:Name="txtFacturas" Grid.Column="1" Text="Facturas" TextColor="#64748B" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" IsVisible="False"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Facturas" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border x:Name="MenuDespacho" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" HeightRequest="45" StrokeThickness="0" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="55, *">
                                <Label Grid.Column="0" Text="📤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Label x:Name="txtDespacho" Grid.Column="1" Text="Despacho" TextColor="#64748B" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" IsVisible="False"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Despacho" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border x:Name="MenuMensajes" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" HeightRequest="45" StrokeThickness="0" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="55, *">
                                <Label Grid.Column="0" Text="💬" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Label x:Name="txtMensajes" Grid.Column="1" Text="Mensajes" TextColor="#64748B" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" IsVisible="False"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Mensajes" />
                            </Border.GestureRecognizers>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <Grid Grid.Row="2" ColumnDefinitions="55, *" Margin="0,15,0,0">
                    <Border Grid.Column="0" StrokeShape="Ellipse" BackgroundColor="Transparent" WidthRequest="45" HeightRequest="45" StrokeThickness="0" HorizontalOptions="Center">
                        <Label Text="🚪" HorizontalOptions="Center" VerticalOptions="Center" FontSize="24"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCerrarSesionClicked" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Label x:Name="lblUsuarioNombre" 
                           Grid.Column="1"
                           Text="Administrador" 
                           TextColor="#94A3B8" 
                           FontAttributes="Bold" 
                           FontSize="12" 
                           VerticalOptions="Center"
                           Margin="5,0,0,0"
                           IsVisible="False"/>
                </Grid>

            </Grid>
        </Border>

        <ContentView x:Name="ContenedorPrincipal" 
                     Grid.Column="1" 
                     BackgroundColor="#0A0E17">
            <Label Text="Contenido de la sección activa" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#1E293B" FontSize="16" FontAttributes="Bold"/>
        </ContentView>

    </Grid>
</ContentPage>