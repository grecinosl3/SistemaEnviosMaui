<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SistemaEnviosMaui"
             x:Class="SistemaEnviosMaui.Views.PrincipalPage"
             Title="PrincipalPage"
             BackgroundColor="#0A0E17"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="70, 90, *">

        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="#0F172A">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.3"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="*, Auto" Padding="20,0">
                <HorizontalStackLayout VerticalOptions="Center" Spacing="12">
                    <Label Text="SISTEMA DE GESTIÓN DE ENVÍOS" 
                            TextColor="White" 
                            FontSize="18" 
                            FontAttributes="Bold" 
                            CharacterSpacing="1"
                            VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="15">

                    <Border StrokeShape="Ellipse" BackgroundColor="#1E293B" WidthRequest="36" HeightRequest="36" StrokeThickness="0">
                        <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16"/>
                    </Border>

                    <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                        <Label Text="En línea" TextColor="#10B981" FontSize="11" FontAttributes="Bold"/>
                        <Label x:Name="lblUsuarioNombre" Text="Invitado" TextColor="#E2E8F0" 
                       FontAttributes="Bold" FontSize="14"/>
                    </VerticalStackLayout>

                    <Border x:Name="BtnSalir" 
                    StrokeShape="RoundRectangle 8" 
                    BackgroundColor="#2D1F1F" 
                    Stroke="#EF4444" 
                    StrokeThickness="1"
                    WidthRequest="40" 
                    HeightRequest="36" 
                    VerticalOptions="Center">
                        <Label Text="🚪" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18"/>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCerrarSesionClicked" />
                        </Border.GestureRecognizers>
                    </Border>

                </HorizontalStackLayout>
            </Grid>
        </Border>
        
        <Grid Grid.Row="1" BackgroundColor="#0A0E17" Padding="15,10">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                    <Border x:Name="MenuInicio" StrokeShape="RoundRectangle 12" Stroke="#2A364F" BackgroundColor="#1E293B" WidthRequest="100" Padding="5">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{x:Static local:Iconos.Inicio}" FontFamily="FontAwesomeSolid" 
                                   FontSize="22" HorizontalOptions="Center" TextColor="#3B82F6"/>
                            <Label Text="Inicio" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Inicio" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="MenuUsuarios" StrokeShape="RoundRectangle 12" Stroke="#2A364F" BackgroundColor="#1E293B" WidthRequest="100" Padding="5">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{x:Static local:Iconos.Usuarios}" FontFamily="FontAwesomeSolid" 
                                   FontSize="22" HorizontalOptions="Center" TextColor="#3B82F6"/>
                            <Label Text="Usuarios" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Usuarios" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="MenuClientes" StrokeShape="RoundRectangle 12" Stroke="#2A364F" BackgroundColor="#1E293B" WidthRequest="100" Padding="5">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{x:Static local:Iconos.Clientes}" FontFamily="FontAwesomeSolid" 
                                   FontSize="22" HorizontalOptions="Center" TextColor="#3B82F6"/>
                            <Label Text="Clientes" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Clientes" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="MenuInventario" StrokeShape="RoundRectangle 12" Stroke="#2A364F" BackgroundColor="#1E293B" WidthRequest="100" Padding="5">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{x:Static local:Iconos.Inventario}" FontFamily="FontAwesomeSolid" 
                                   FontSize="22" HorizontalOptions="Center" TextColor="#3B82F6"/>
                            <Label Text="Inventario" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Inventario" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="MenuPedidos" StrokeShape="RoundRectangle 12" Stroke="#2A364F" BackgroundColor="#1E293B" WidthRequest="100" Padding="5">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{x:Static local:Iconos.Pedidos}" FontFamily="FontAwesomeSolid" 
                                   FontSize="22" HorizontalOptions="Center" TextColor="#3B82F6"/>
                            <Label Text="Pedidos" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Pedidos" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="MenuRepartidores" StrokeShape="RoundRectangle 12" Stroke="#2A364F" BackgroundColor="#1E293B" WidthRequest="105" Padding="5">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{x:Static local:Iconos.Repartidores}" FontFamily="FontAwesomeSolid" 
                                   FontSize="22" HorizontalOptions="Center" TextColor="#3B82F6"/>
                            <Label Text="Repartidores" HorizontalOptions="Center" FontSize="11" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Repartidores" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="MenuFacturas" StrokeShape="RoundRectangle 12" Stroke="#2A364F" BackgroundColor="#1E293B" WidthRequest="100" Padding="5">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{x:Static local:Iconos.Facturas}" FontFamily="FontAwesomeSolid" 
                                   FontSize="22" HorizontalOptions="Center" TextColor="#3B82F6"/>
                            <Label Text="Facturas" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Facturas" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="MenuDespacho" StrokeShape="RoundRectangle 12" Stroke="#2A364F" BackgroundColor="#1E293B" WidthRequest="100" Padding="5">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{x:Static local:Iconos.Facturas}" FontFamily="FontAwesomeSolid" 
                                   FontSize="22" HorizontalOptions="Center" TextColor="#3B82F6"/>
                            <Label Text="Despacho" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuOptionTapped" CommandParameter="Despacho" />
                        </Border.GestureRecognizers>
                    </Border>

                </HorizontalStackLayout>
            </ScrollView>
        </Grid>

        <ContentView x:Name="ContenedorPrincipal" 
                     Grid.Row="2" 
                     BackgroundColor="#0F172A"
                     Margin="15,0,15,15">
            <ContentView.ControlTemplate>
                <ControlTemplate>
                    <Border StrokeShape="RoundRectangle 16" Stroke="#2A364F" BackgroundColor="#121824" Padding="20">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </ContentView.ControlTemplate>

            <Label Text="Seleccione una opción del menú superior para comenzar" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" 
                   TextColor="#64748B"
                   FontSize="15"
                   FontAttributes="Italic"/>
        </ContentView>

    </Grid>
</ContentPage>