<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemaEnviosMaui.Views.LoginPage"
             Title="Bienvenido"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

        <Image Source="dotnet_bot.png"
               HeightRequest="100"
               HorizontalOptions="Center" />

        <Label Text="Inicio de Sesión"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#333"
               HorizontalOptions="Center" />

        <Frame Padding="10,0" CornerRadius="10" HasShadow="False" BorderColor="#CCCCCC">
            <Entry x:Name="txtCorreo" 
                   Placeholder="Correo electrónico" 
                   Keyboard="Email"
                   HeightRequest="45"/>
        </Frame>

        <Frame Padding="10,0" CornerRadius="10" HasShadow="False" BorderColor="#CCCCCC">
            <Entry x:Name="txtPassword" 
                   Placeholder="Contraseña" 
                   IsPassword="True"
                   HeightRequest="45"/>
        </Frame>

        <Button x:Name="btnIngresar"
                Text="INGRESAR"
                BackgroundColor="#2196F3"
                TextColor="White"
                FontAttributes="Bold"
                HeightRequest="50"
                CornerRadius="10"
                Clicked="btnIngresar_Clicked"/>

        <ActivityIndicator x:Name="indicador" IsRunning="False" HorizontalOptions="Center" Color="#2196F3" />

    </VerticalStackLayout>
</ContentPage>