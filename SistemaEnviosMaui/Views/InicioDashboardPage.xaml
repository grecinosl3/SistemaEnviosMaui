<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SistemaEnviosMaui.Views.InicioDashboardPage"
             BackgroundColor="#121212">

    <ScrollView Padding="30">
        <VerticalStackLayout Spacing="25">

            <VerticalStackLayout Spacing="5">
                <Label Text="PANEL DE CONTROL GENERAL" FontSize="14" TextColor="#3498db" FontAttributes="Bold" CharacterSpacing="1.5"/>
                <Label Text="Rendimiento Logístico del Día" FontSize="24" TextColor="White" FontAttributes="Bold"/>
                <BoxView HeightRequest="1" BackgroundColor="#2b2b2b" Margin="0,10,0,10"/>
            </VerticalStackLayout>

            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">

                <Frame BackgroundColor="#1a243a" BorderColor="#3498db" CornerRadius="12" WidthRequest="220" HeightRequest="130" Padding="15" Margin="0,10">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text=" EN BODEGA" TextColor="#3498db" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label x:Name="lblPendientes" Text="0" TextColor="White" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Esperando piloto" TextColor="#888888" FontSize="11" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="#2a2015" BorderColor="#e67e22" CornerRadius="12" WidthRequest="220" HeightRequest="130" Padding="15" Margin="0,10">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text=" EN RUTA" TextColor="#e67e22" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label x:Name="lblEnRuta" Text="0" TextColor="White" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Paquetes en la calle" TextColor="#888888" FontSize="11" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="#152a1c" BorderColor="#2ecc71" CornerRadius="12" WidthRequest="220" HeightRequest="130" Padding="15" Margin="0,10">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="ENTREGADOS" TextColor="#2ecc71" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label x:Name="lblLiquidados" Text="0" TextColor="White" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Ciclo completo con éxito" TextColor="#888888" FontSize="11" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="#1f1f1f" BorderColor="#2ecc71" CornerRadius="12" WidthRequest="260" HeightRequest="130" Padding="15" Margin="0,10">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text=" EFECTIVO RECAUDADO" TextColor="#2ecc71" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label x:Name="lblTotalEfectivo" Text="Q 0.00" TextColor="#2ecc71" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Caja total ingresada" TextColor="#888888" FontSize="11" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

            </FlexLayout>

            <Frame BackgroundColor="#1e1e1e" CornerRadius="10" HasShadow="False" Padding="20" Margin="0,10,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Estatus del Servidor de Base de Datos" TextColor="White" FontAttributes="Bold" FontSize="14"/>
                    <HorizontalStackLayout Spacing="10">
                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" BackgroundColor="#2ecc71" VerticalOptions="Center"/>
                        <Label Text="Conectado a SQL Server - Transacciones en tiempo real activas." TextColor="#aaaaaa" FontSize="13"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>