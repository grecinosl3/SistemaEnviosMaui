<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SistemaEnviosMaui.Views.DespachoRutasPage"
             BackgroundColor="#121212">

    <Grid ColumnDefinitions="*, 400" ColumnSpacing="20" Margin="20">

        <Grid Grid.Column="0" RowDefinitions="Auto, *">
            <Label Grid.Row="0" Text="GUÍAS LOGÍSTICAS ESPERANDO ASIGNACIÓN" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="0,0,0,15"/>

            <Frame Grid.Row="1" BackgroundColor="#1e1e1e" CornerRadius="10" HasShadow="False" Padding="0">
                <Grid RowDefinitions="Auto, *">

                    <Grid Grid.Row="0" BackgroundColor="#2b2b2b" Padding="12" ColumnDefinitions="1*, 2.5*, 3*, 1.5*">
                        <Label Text="No. Guía" TextColor="#3498db" FontAttributes="Bold"/>
                        <Label Grid.Column="1" Text="Cliente / Remitente" TextColor="#3498db" FontAttributes="Bold"/>
                        <Label Grid.Column="2" Text="Dirección de Entrega" TextColor="#3498db" FontAttributes="Bold"/>
                        <Label Grid.Column="3" Text="Total a Cobrar" TextColor="#3498db" FontAttributes="Bold" HorizontalOptions="End"/>
                    </Grid>

                    <CollectionView Grid.Row="1" x:Name="lstPendientes" SelectionMode="Single" SelectionChanged="OnPedidoSeleccionado">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12" ColumnDefinitions="1*, 2.5*, 3*, 1.5*" BackgroundColor="#1a1a1a">
                                    <Label Text="{Binding IdPedido}" TextColor="#e67e22" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding NombreDestinatario}" TextColor="White" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="{Binding DireccionEntrega}" TextColor="#aaaaaa" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                    <Label Grid.Column="3" Text="{Binding Total, StringFormat='Q {0:F2}'}" TextColor="#2ecc71" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Frame>
        </Grid>

        <Frame Grid.Column="1" BackgroundColor="#1e1e1e" CornerRadius="10" HasShadow="False" Padding="20" HeightRequest="450" VerticalOptions="Start">
            <VerticalStackLayout Spacing="20">
                <Label Text="PANEL DE DESPACHO" FontSize="16" FontAttributes="Bold" TextColor="#2ecc71" HorizontalOptions="Center"/>
                <BoxView HeightRequest="1" BackgroundColor="#333333"/>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Guía Seleccionada:" TextColor="#888888" FontSize="12"/>
                    <Label x:Name="lblGuíaSeleccionada" Text="Ninguna - Seleccione de la lista" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Destinatario:" TextColor="#888888" FontSize="12"/>
                    <Label x:Name="lblDestinatario" Text="--" TextColor="#aaaaaa" FontSize="14"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Asignar Piloto / Motorista:" TextColor="White" FontAttributes="Bold" FontSize="14"/>
                    <Picker x:Name="cboRepartidores" BackgroundColor="#2b2b2b" TextColor="White" Title="Seleccione un conductor..." ItemDisplayBinding="{Binding NombreCompleto}"/>
                </VerticalStackLayout>

                <Button x:Name="btnDespachar" Text="Despachar e Iniciar Ruta" BackgroundColor="#3498db" TextColor="White" FontAttributes="Bold" HeightRequest="50" Margin="0,20,0,0" Clicked="OnDespacharClicked"/>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentView>