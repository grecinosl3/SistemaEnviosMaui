<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemaEnviosMaui.Views.ListaChatsPage"
             BackgroundColor="#121212">

    <Grid ColumnDefinitions="350, *" Padding="20" ColumnSpacing="20">

        <Border Grid.Column="0" BackgroundColor="#1e1e1e" StrokeShape="RoundRectangle 15" Stroke="#333333" StrokeThickness="1" Padding="20">
            <VerticalStackLayout Spacing="15" VerticalOptions="Center">
                <Label Text="INFORMACIÓN" TextColor="#3498db" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Margin="0,0,0,10"/>

                <Border StrokeShape="RoundRectangle 40" WidthRequest="80" HeightRequest="80" BackgroundColor="#252525" StrokeThickness="0" HorizontalOptions="Center">
                    <Label Text="👤" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <Label x:Name="lblNombreContacto" Text="Selecciona un chat" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Label x:Name="lblRolContacto" Text="Puesto" TextColor="#888888" FontSize="14" HorizontalOptions="Center"/>

                <BoxView HeightRequest="1" Color="#333333" Margin="0,10"/>

                <Button x:Name="btnAbrirChat" 
                        Text="INICIAR CHAT" 
                        BackgroundColor="#3498db" 
                        CornerRadius="8" 
                        HeightRequest="50" 
                        FontAttributes="Bold" 
                        IsEnabled="False"
                        Clicked="btnAbrirChat_Click"/>
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Grid.Column="1" Spacing="20">
            <Label Text="Bandeja de Entrada y Contactos" TextColor="White" FontSize="28" FontAttributes="Bold"/>

            <Border BackgroundColor="#1e1e1e" StrokeShape="RoundRectangle 10" Padding="0" Stroke="#333333" StrokeThickness="1">
                <CollectionView x:Name="dgvContactos" SelectionMode="Single" SelectionChanged="dgvContactos_SelectionChanged">

                    <CollectionView.Header>
                        <Grid BackgroundColor="#252525" ColumnDefinitions="80, *, 150" Padding="15">
                            <Label Text="ID" Grid.Column="0" TextColor="#3498db" FontAttributes="Bold" FontSize="12"/>
                            <Label Text="NOMBRE COMPLETO" Grid.Column="1" TextColor="#3498db" FontAttributes="Bold" FontSize="12" Margin="10,0,0,0"/>
                            <Label Text="ROL / PUESTO" Grid.Column="2" TextColor="#3498db" FontAttributes="Bold" FontSize="12"/>
                        </Grid>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="80, *, 150" Padding="15">
                                <Label Text="{Binding IdUsuario}" Grid.Column="0" TextColor="#888888" VerticalOptions="Center"/>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0,0,0">
                                    <Label Text="{Binding NombreCompleto}" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                                    <Label Text="Disponible en línea" TextColor="#2ec4b6" FontSize="11"/>
                                </VerticalStackLayout>

                                <Label Text="{Binding oRol.NombreRol}" Grid.Column="2" TextColor="#cccccc" VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentView>