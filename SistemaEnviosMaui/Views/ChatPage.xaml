<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SistemaEnviosMaui.ViewModels"
             x:Class="SistemaEnviosMaui.Views.ChatPage">

    <Grid ColumnDefinitions="350, *" Padding="20" ColumnSpacing="20" BackgroundColor="#121212">

        <Border Grid.Column="0" BackgroundColor="#1e1e1e" StrokeShape="RoundRectangle 15" Stroke="#333333" StrokeThickness="1">
            <VerticalStackLayout Spacing="15" VerticalOptions="Center" HorizontalOptions="Center">

                <Label Text="SALA DE MENSAJERÍA" TextColor="#3498db" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Margin="0,0,0,10"/>

                <Border StrokeShape="RoundRectangle 50" WidthRequest="80" HeightRequest="80" BackgroundColor="#252525" StrokeThickness="0">
                    <Label Text="💬" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <Label Text="Canal Activo" TextColor="#888888" FontSize="13" HorizontalOptions="Center"/>
                <Label Text="Soporte Técnico / Central" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>

                <BoxView HeightRequest="1" Color="#333333" Margin="0,10"/>

                <Label Text="Los mensajes se sincronizan en tiempo real con la base de datos central de envíos." 
                       TextColor="#666666" FontSize="11" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto" RowSpacing="20">

            <Label Grid.Row="0" Text="Historial de Mensajes" TextColor="White" FontSize="28" FontAttributes="Bold"/>

            <Border Grid.Row="1" BackgroundColor="#1e1e1e" StrokeShape="RoundRectangle 10" Padding="15" Stroke="#333333" StrokeThickness="1">

                <CollectionView x:Name="dgvdata" ItemsSource="{Binding ListaMensajes}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,5">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12" WidthRequest="320">

                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding EsMensajeMio}" Value="True">
                                            <Setter Property="HorizontalOptions" Value="End"/>
                                            <Setter Property="BackgroundColor" Value="#0f5132"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding EsMensajeMio}" Value="False">
                                            <Setter Property="HorizontalOptions" Value="Start"/>
                                            <Setter Property="BackgroundColor" Value="#252525"/>
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <VerticalStackLayout>
                                        <Label Text="{Binding Mensaje}" FontSize="14" TextColor="White" HorizontalOptions="Start"/>
                                        <Label Text="{Binding FechaEnvio, StringFormat='{0:HH:mm}'}" FontSize="9" TextColor="#888888" HorizontalOptions="End" Margin="0,3,0,0"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="15">

                <Entry Grid.Column="0" 
                       x:Name="txtMensaje"
                       Placeholder="Escribe un mensaje aquí..." 
                       PlaceholderColor="#666666"
                       BackgroundColor="#1e1e1e"
                       TextColor="White"
                       HeightRequest="50"
                       VerticalOptions="Center"/>

                <Button Grid.Column="1" 
                        Text="ENVIAR" 
                        Clicked="BtnEnviar_Clicked"
                        BackgroundColor="#3498db" 
                        TextColor="White"
                        CornerRadius="8"
                        WidthRequest="120"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        VerticalOptions="Center"/>
            </Grid>
        </Grid>
    </Grid>
</ContentView>