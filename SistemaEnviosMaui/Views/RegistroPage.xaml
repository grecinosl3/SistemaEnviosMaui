<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemaEnviosMaui.Views.RegistroPage"
             Title="RegistroPage"
             BackgroundColor="#121212">

    <VerticalStackLayout Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">

        <Label Text="Formulario de Registro"
               FontSize="24"
               TextColor="White"
               HorizontalOptions="Center" />

        <Entry Placeholder="Nombre Completo" WidthRequest="300" />
        <Entry Placeholder="Correo Electrónico" WidthRequest="300" />
        <Entry Placeholder="Contraseña" IsPassword="True" WidthRequest="300" />

        <Button Text="Finalizar Registro"
                BackgroundColor="#2ecc71"
                WidthRequest="200" />

        <Button Text="Volver al Login"
                Clicked="OnVolverClicked"
                BackgroundColor="Transparent"
                TextColor="#42A5F5" />

    </VerticalStackLayout>
</ContentPage>