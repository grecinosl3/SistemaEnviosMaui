@page "/staff"
@rendermode InteractiveServer
<div class="container mt-5">
    <div class="card border-0 shadow">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0"><i class="bi bi-truck me-2"></i>Consola de Operaciones & Despacho (Moderador)</h5>
        </div>
        <div class="card-body p-4">
            <p class="text-muted">Desde este panel, el personal de almacén puede escanear códigos de barras, reasignar rutas departamentales y actualizar estados en tiempo real (Pendiente ➔ En Tránsito ➔ Entregado).</p>
            <button class="btn btn-outline-primary btn-sm"><i class="bi bi-plus-circle me-1"></i> Registrar Cambio de Estado Masivo</button>
        </div>
    </div>
</div>