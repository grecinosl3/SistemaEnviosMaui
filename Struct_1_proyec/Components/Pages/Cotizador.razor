@page "/cotizador"
@using Struct_1_proyec.Services
@inject CotizadorService cotizadorService

<PageTitle>Calculadora de Tarifas | RerF Logistics</PageTitle>

<div class="container my-5">
    <div class="d-flex align-items-center mb-5 p-3 bg-white shadow-sm rounded-3 border-start border-4 border-warning">
        <i class="bi bi-calculator display-4 text-warning me-3"></i>
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">Calculadora de Tarifas</h1>
            <p class="text-muted mb-0">Módulo operativo para la cotización de fletes y proyección de costos netos.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@mensajeError</div>
            <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow border-0 rounded-3 mb-4">
                <div class="card-body p-4">

                    <h5 class="card-title fw-bold text-primary mb-4">
                        <i class="bi bi-map me-2"></i>Ruta Nacional de Distribución
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select border-2" id="origenSelect" @bind="origen">
                                    <option value="">Selecciona origen...</option>
                                    @foreach (var dept in departamentosGuatemala)
                                    {
                                        <option value="@dept">@dept</option>
                                    }
                                </select>
                                <label for="origenSelect"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Origen (Recolección)</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select border-2" id="destinoSelect" @bind="destino">
                                    <option value="">Selecciona destino...</option>
                                    @foreach (var dept in departamentosGuatemala)
                                    {
                                        <option value="@dept">@dept</option>
                                    }
                                </select>
                                <label for="destinoSelect"><i class="bi bi-flag-fill text-success me-1"></i>Destino (Entrega)</label>
                            </div>
                        </div>
                    </div>

                    <h5 class="card-title fw-bold text-primary mb-4">
                        <i class="bi bi-box-seam me-2"></i>Métricas del Paquete
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small mb-1">Peso del Paquete</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-2"><i class="bi bi-balance-scale"></i></span>
                                <input type="number" class="form-control border-2" placeholder="0.00" @bind="peso" min="0.1" step="0.1">
                                <span class="input-group-text bg-light border-2 fw-bold text-muted">Lbs.</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small mb-1">Costo de la Mercancía (Valor Producto)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-2 text-success fw-bold">Q</span>
                                <input type="number" class="form-control border-2" placeholder="0.00" @bind="costoProducto" min="0.00">
                            </div>
                        </div>
                    </div>

                    <div class="d-grid mt-5">
                        <button class="btn btn-warning btn-lg fw-bold py-3 shadow" @onclick="ProcesarCotizacion">
                            <i class="bi bi-gear-fill me-2"></i>Calcular Tarifa de Envío
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow border-0 rounded-3 h-100 bg-white">
                <div class="card-body p-4 d-flex flex-column">

                    <h5 class="fw-bold text-dark mb-4 pb-2 border-bottom">
                        <i class="bi bi-receipt me-2 text-primary"></i>Proyección de Costos
                    </h5>

                    @if (calculado)
                    {
                        <div class="bg-light p-3 rounded-3 mb-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Costo del Producto:</span>
                                <span class="fw-bold text-dark">Q @costoProducto.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Flete / Costo de Envío:</span>
                                <span class="fw-bold text-dark">Q @costoEnvio.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 border-top pt-2">
                                <span class="text-muted">Subtotal Neto:</span>
                                <span class="fw-bold text-dark">Q @subtotalNeto.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 text-danger">
                                <span>Estimatación IVA (12%):</span>
                                <span class="fw-bold">Q @ivaCalculado.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between border-top pt-2 mt-2">
                                <span class="fw-bold text-dark fs-5">Total Proyectado:</span>
                                <span class="fw-bold text-success fs-4">Q @totalGeneral.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="border border-dashed border-2 p-3 bg-white rounded-3 mt-auto position-relative border-secondary">
                            <div class="text-center mb-2">
                                <span class="badge bg-secondary text-uppercase tracking-wider">Vista Previa de Cotización</span>
                                <h6 class="fw-bold mt-2 mb-0">RerF LOGISTICS, S.A.</h6>
                                <small class="text-muted text-xs">Guatemala</small>
                            </div>
                            <hr class="my-2" />
                            <div class="small">
                                <div><strong>Fecha:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                                <div><strong>Origen:</strong> @origen ➔ <strong>Destino:</strong> @destino</div>
                            </div>
                            <hr class="my-2" />
                            <table class="w-100 small mb-2">
                                <thead>
                                    <tr class="border-bottom">
                                        <th>Desc.</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Valor de Mercancía</td>
                                        <td class="text-end">Q @costoProducto.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Servicio Courier (@peso Lbs)</td>
                                        <td class="text-end">Q @costoEnvio.ToString("N2")</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="d-flex justify-content-between fw-bold border-top pt-1 small">
                                <span>Total Estimado:</span>
                                <span>Q @totalGeneral.ToString("N2")</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="my-auto text-center py-5">
                            <i class="bi bi-receipt-cutoff display-1 text-muted opacity-25 mb-4"></i>
                            <h6 class="fw-bold text-muted">Listo para calcular</h6>
                            <p class="text-muted small mb-0 px-3">Ingresa la ruta y métricas del paquete para generar la proyección de costos de distribución.</p>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<string> departamentosGuatemala = new()
    {
        "Alta Verapaz", "Baja Verapaz", "Chimaltenango", "Chiquimula", "El Progreso",
        "Escuintla", "Guatemala", "Huehuetenango", "Izabal", "Jalapa", "Jutiapa",
        "Petén", "Quetzaltenango", "Quiché", "Retalhuleu", "Sacatepéquez",
        "San Marcos", "Santa Rosa", "Sololá", "Suchitepéquez", "Totonicapán", "Zacapa"
    };

    // Parametros de captura
    string origen = "";
    string destino = "";
    decimal peso = 1;
    decimal costoProducto = 0;

    // Parametros de salida de Dinero
    decimal costoEnvio;
    decimal subtotalNeto;
    decimal ivaCalculado;
    decimal totalGeneral;

    bool calculated = false;
    bool calculado => calculated;
    string mensajeError = "";

    void ProcesarCotizacion()
    {
        if (string.IsNullOrEmpty(origen) || string.IsNullOrEmpty(destino))
        {
            mensajeError = "Debes seleccionar obligatoriamente un Departamento de Origen y uno de Destino.";
            calculated = false;
            return;
        }

        if (peso <= 0)
        {
            mensajeError = "El peso del paquete debe ser mayor a 0 libras.";
            calculated = false;
            return;
        }

        mensajeError = "";

        // Llamada al servicio de cotización para obtener el costo de envío basado en la ruta y peso
        costoEnvio = cotizadorService.CalcularCostoEnvio(destino, peso);

        // Cálculos de la proyección
        totalGeneral = costoProducto + costoEnvio;
        subtotalNeto = totalGeneral / 1.12m;
        ivaCalculado = totalGeneral - subtotalNeto;

        calculated = true;
    }
}