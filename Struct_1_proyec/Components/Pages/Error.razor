@page "/Error"
@using System.Diagnostics
<PageTitle>Error | RerF Logistics</PageTitle>

<div class="container my-5 text-center">
    <i class="bi bi-exclamation-triangle-fill text-warning display-1"></i>
    <h1 class="text-dark fw-bold mt-3">¡Ups! Algo salió mal</h1>
    <p class="text-muted">Hemos tenido un inconveniente procesando tu solicitud.</p>

    @if (ShowRequestId)
    {
        <div class="mt-4">
            <p class="text-secondary small">ID de incidencia: <code>@RequestId</code></p>
        </div>
    }

    <div class="mt-4">
        <a href="/" class="btn btn-dark px-4 shadow-sm">Regresar al Inicio</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}