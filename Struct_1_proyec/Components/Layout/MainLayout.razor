@inherits LayoutComponentBase
@inject NavigationManager Nav

<div style="min-height: 100vh; background-color: #f8f9fa;">
    <header>
        @* BARRA DE NAVEGACIÓN SUPERIOR *@
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 py-2" style="box-shadow: 0 4px 10px rgba(0,0,0,0.15);">
            <div class="container-fluid d-flex justify-content-between align-items-center">

                @* Brand / Logo *@
                <a class="navbar-brand d-flex align-items-center fw-bold fs-3 text-white" href="/">
                    <div class="bg-warning text-dark rounded-3 d-inline-flex p-2 me-2 shadow-sm" style="font-size: 1.2rem;">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                    <span>RerF<span class="text-warning">.</span></span>
                </a>

                @* Enlaces de Navegación del Sistema *@
                <div class="d-flex align-items-center gap-4">
                    <a href="/" class="text-white text-decoration-none small fw-semibold d-flex align-items-center gap-1 opacity-75 hover-opacity-100">
                        <i class="bi bi-house-door"></i> Inicio
                    </a>
                    <a href="tracking" class="text-white text-decoration-none small fw-semibold d-flex align-items-center gap-1 opacity-75 hover-opacity-100">
                        <i class="bi bi-geo-alt"></i> Rastreo
                    </a>
                    <a href="cotizador" class="text-white text-decoration-none small fw-semibold d-flex align-items-center gap-1 opacity-75 hover-opacity-100">
                        <i class="bi bi-calculator"></i> Cotizador
                    </a>
                    <a href="registrar-envio" class="text-white text-decoration-none small fw-semibold d-flex align-items-center gap-1 opacity-75 hover-opacity-100">
                        <i class="bi bi-box-seam"></i> Registrar Envío
                    </a>
                    <a href="contacto" class="text-white text-decoration-none small fw-semibold d-flex align-items-center gap-1 opacity-75 hover-opacity-100">
                        <i class="bi bi-envelope"></i> Soporte
                    </a>
                </div>

                <div style="width: 40px;"></div>
            </div>
        </nav>
    </header>

    @* Cuerpo principal de la aplicación *@
    <main>
        <div class="container-fluid p-0">
            @Body
        </div>
    </main>
</div>

<style>
    .hover-opacity-100:hover {
        opacity: 1 !important;
        color: #ffc107 !important;
        transition: all 0.2s ease-in-out;
    }
</style>