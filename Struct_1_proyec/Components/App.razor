<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
   @* Estilos personalizados para la aplicación *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            /* Estilos personalizados para la aplicación */
            :root {
                --brand-dark: #111111;
                --brand-accent: #FFCC00;
            }
            .bg-brand-dark { background-color: var(--brand-dark) !important; }
            .text-brand-accent { color: var(--brand-accent) !important; }
            .btn-brand { background-color: var(--brand-accent); color: var(--brand-dark); font-weight: 600; }
            .btn-brand:hover { background-color: #e6b800; color: var(--brand-dark); }

            /* Estilos para la línea de tiempo gráfica del Tracking */
            .timeline-wrapper { position: relative; padding-left: 30px; border-left: 3px dashed #dee2e6; }
            .timeline-item { position: relative; margin-bottom: 25px; }
            .timeline-dot { position: absolute; left: -41px; top: 2px; width: 18px; height: 18px; border-radius: 50%; background: #3b82f6; border: 4px solid #fff; box-shadow: 0 0 0 3px #3b82f6; }
            .timeline-item.success .timeline-dot { background: #10b981; box-shadow: 0 0 0 3px #10b981; }
    </style>
    <HeadOutlet />
</head>

<body class="bg-light">
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>